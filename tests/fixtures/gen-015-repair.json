  "reference": "<section class=\"sm-hero\" aria-labelledby=\"sm-hero-title\">\n  <!-- Revision note: Playwright desktop and mobile measurements at 1440, 768 and 375 CSS px were not captured in this revision. No-overflow, clipping and line-wrap results at those widths are unverified until measured in a browser. -->\n  <style>\n    .sm-hero {\n      --sm-hero-bg-start: #18283a;\n      --sm-hero-bg-end: #2b4a6b;\n      --sm-hero-text: #ffffff;\n      --sm-hero-muted: #e3e9f0;\n      --sm-hero-cta-bg: #f5e6c8;\n      --sm-hero-cta-text: #18283a;\n      --sm-hero-focus: #ffd966;\n      --sm-hero-space-block: clamp(3rem, 2rem + 6vw, 6.5rem);\n      --sm-hero-space-inline: clamp(1.25rem, 0.75rem + 3vw, 3rem);\n      --sm-hero-gap: clamp(1rem, 0.6rem + 1.5vw, 1.75rem);\n      --sm-hero-content-width: 42rem;\n      --sm-hero-radius: 999px;\n\n      box-sizing: border-box;\n      background: linear-gradient(135deg, var(--sm-hero-bg-start) 0%, var(--sm-hero-bg-end) 100%);\n      color: var(--sm-hero-text);\n      font-family: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n      padding: var(--sm-hero-space-block) var(--sm-hero-space-inline);\n      overflow-wrap: break-word;\n      word-break: normal;\n    }\n\n    .sm-hero *,\n    .sm-hero *::before,\n    .sm-hero *::after {\n      box-sizing: border-box;\n    }\n\n    /* Container-level width control: centers the content group.\n       No max-width is applied to individual text leaves. */\n    .sm-hero__content {\n      width: 100%;\n      max-width: var(--sm-hero-content-width);\n      margin-inline: auto;\n    }\n\n    .sm-hero__inner {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n      gap: var(--sm-hero-gap);\n    }\n\n    .sm-hero__eyebrow {\n      margin: 0;\n      font-size: clamp(0.8rem, 0.75rem + 0.25vw, 0.95rem);\n      font-weight: 600;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: var(--sm-hero-muted);\n    }\n\n    .sm-hero__title {\n      margin: 0;\n      font-size: clamp(2rem, 1.2rem + 3.5vw, 4rem);\n      line-height: 1.1;\n      font-weight: 700;\n      letter-spacing: -0.01em;\n      color: var(--sm-hero-text);\n      text-wrap: balance;\n    }\n\n    .sm-hero__intro {\n      margin: 0;\n      font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);\n      line-height: 1.6;\n      color: var(--sm-hero-muted);\n      text-wrap: pretty;\n    }\n\n    .sm-hero__cta {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 2.75rem;\n      margin-top: calc(var(--sm-hero-gap) * 0.25);\n      padding: 0.75rem clamp(1.25rem, 1rem + 1vw, 2rem);\n      border-radius: var(--sm-hero-radius);\n      background: var(--sm-hero-cta-bg);\n      color: var(--sm-hero-cta-text);\n      font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);\n      font-weight: 600;\n      line-height: 1.2;\n      text-decoration: none;\n      text-align: center;\n      max-width: 100%;\n    }\n\n    .sm-hero__cta:hover {\n      text-decoration: underline;\n    }\n\n    .sm-hero__cta:focus-visible {\n      outline: 3px solid var(--sm-hero-focus);\n      outline-offset: 3px;\n    }\n\n    @media (min-width: 48rem) {\n      .sm-hero__inner {\n        gap: clamp(1.25rem, 1rem + 1vw, 2rem);\n      }\n    }\n  </style>\n\n  <div class=\"sm-hero__content\">\n    <div class=\"sm-hero__inner\">\n      <p class=\"sm-hero__eyebrow\">Welcome</p>\n      <h2 class=\"sm-hero__title\" id=\"sm-hero-title\">Rest well in a space designed for you</h2>\n      <p class=\"sm-hero__intro\">\n        Settle into calm, considered rooms with thoughtful details, attentive service and\n        comfortable spaces for work, rest and time together. Every stay is planned around your pace.\n      </p>\n      <a class=\"sm-hero__cta\" href=\"#rooms\">View available rooms</a>\n    </div>\n  </div>\n</section>",
